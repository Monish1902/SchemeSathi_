rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users can read and write their own profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Government schemes catalog - readable by everyone
    match /schemes/{schemeId} {
      allow read: if true;
      allow write: if false;
    }

    // Eligibility assessments belong to individual users
    match /eligibilityAssessments/{assessmentId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // User scheme applications
    match /userApplications/{applicationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }

    // Scheme updates are readable by everyone
    match /schemeUpdates/{updateId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
